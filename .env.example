# Sahaay Environment Configuration
# Copy this file to .env and configure your variables

# AI Model Provider Configuration
SAHAAY_AI_PROVIDER=hybrid
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Security & HMAC Hashing Key (for phone/identity privacy preservation)
SAHAAY_HMAC_KEY=sahaay-emergency-triage-hmac-salt-2026-bvp

# Database (Leave blank to use default SQLite database)
# DATABASE_URL=postgresql://user:password@localhost:5432/sahaay
